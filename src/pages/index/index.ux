<template>
  <div class="page">
    <text class="clock">{{ hh }}:{{ mm }}</text>
    <text class="date">{{ dateText }}</text>
    <text class="temp">{{ temp }}°</text>
    <text class="desc">{{ desc }} · {{ city }}</text>
    <text class="range">今日 {{ low }}° ~ {{ high }}°</text>
    <text class="btn" onclick="refresh">刷新天气</text>
    <text class="tip">{{ status }}</text>
  </div>
</template>
<style>
  .page { flex-direction: column; align-items: center; width: 432px; height: 514px; background-color: #000; padding: 32px; }
  .clock { color: #fff; font-size: 96px; }
  .date { color: #8a8a8a; font-size: 28px; margin-bottom: 24px; }
  .temp { color: #fff; font-size: 88px; }
  .desc { color: #fff; font-size: 32px; }
  .range { color: #8a8a8a; font-size: 26px; margin-bottom: 24px; }
  .btn { width: 200px; height: 64px; border-radius: 32px; background-color: #1c1c1e; color: #fff; font-size: 28px; text-align: center; }
  .tip { color: #8a8a8a; font-size: 22px; margin-top: 10px; }
</style>
<script>
import fetch from "@system.fetch"
export default {
  private: { hh: "--", mm: "--", dateText: "", city: "定位中", temp: "--", desc: "—", low: "--", high: "--", status: "" },
  onInit() { this.tick(); setInterval(() => this.tick(), 10000); this.refresh() },
  tick() {
    const d = new Date()
    this.hh = String(d.getHours()).padStart(2, "0"); this.mm = String(d.getMinutes()).padStart(2, "0")
    this.dateText = (d.getMonth() + 1) + "月" + d.getDate() + "日 星期" + "日一二三四五六"[d.getDay()]
  },
  refresh() {
    // Open-Meteo 免费接口（无需 key）；默认坐标可在 common/config.js 修改为你的城市
    fetch.fetch({
      url: "https://api.open-meteo.com/v1/forecast?latitude=36.06&longitude=103.83&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min&timezone=Asia%2FShanghai",
      responseType: "json",
      success: res => {
        const d = res.data; this.city = "兰州"
        this.temp = Math.round(d.current.temperature_2m)
        this.high = Math.round(d.daily.temperature_2m_max[0]); this.low = Math.round(d.daily.temperature_2m_min[0])
        this.desc = "天气代码 " + d.current.weather_code; this.status = "已更新"
      },
      fail: () => { this.status = "网络不可用" }
    })
  }
}
</script>
